@page "/schedule"
@using ScheduleMaker.App.Application
@using ScheduleMaker.App.Domain
@using System.Globalization
@inject ApplicationStateStore StateStore
@inject ConfigurationStateService ConfigurationStateService

<PageTitle>Schedule - Schedule Maker</PageTitle>

@{
    var validation = ConfigurationStateService.ValidateCurrentConfiguration();
}

<section class="welcome-panel" aria-labelledby="page-title">
    <p class="eyebrow">Schedule Maker</p>
    <h1 id="page-title">Build your schedule</h1>
    <p class="intro">Add dated events, generate assignments, and review the latest schedule.</p>
</section>

@if (!string.IsNullOrWhiteSpace(StateStore.PersistenceError))
{
    <p class="error-message" role="alert">@StateStore.PersistenceError</p>
}

<section class="setup-panel" aria-labelledby="events-title">
    <div class="section-header">
        <h2 id="events-title">Dated events</h2>
        <p class="section-description">Add each event date and choose the event type whose tasks should be scheduled.</p>
    </div>

    @if (eventTypes.Count == 0)
    {
        <p class="empty-state">Add an event type before creating a dated event.</p>
    }
    else
    {
        <form class="event-form" @onsubmit="AddScheduledEventAsync" @onsubmit:preventDefault="true">
            @if (!string.IsNullOrWhiteSpace(scheduledEventErrorMessage))
            {
                <p class="field-error" role="alert">@scheduledEventErrorMessage</p>
            }
            <div class="event-form-field">
                <label for="scheduled-event-date">Date</label>
                <input id="scheduled-event-date"
                       type="date"
                       class="participant-input"
                       @bind="scheduledEventDate"
                       aria-describedby="scheduled-event-date-help scheduled-event-date-error"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(scheduledEventDateErrorMessage))" />
                <p id="scheduled-event-date-help" class="field-help">Choose when this event takes place.</p>
                @if (!string.IsNullOrWhiteSpace(scheduledEventDateErrorMessage))
                {
                    <p id="scheduled-event-date-error" class="field-error" role="alert">@scheduledEventDateErrorMessage</p>
                }
            </div>
            <div class="event-form-field">
                <label for="scheduled-event-type">Event type</label>
                <select id="scheduled-event-type"
                        class="participant-input"
                        @bind="selectedEventTypeId"
                        aria-describedby="scheduled-event-type-error"
                        aria-invalid="@(!string.IsNullOrWhiteSpace(scheduledEventTypeErrorMessage))">
                    <option value="">Select an event type</option>
                    @foreach (var eventType in eventTypes)
                    {
                        <option value="@eventType.Id">@eventType.Name</option>
                    }
                </select>
                @if (!string.IsNullOrWhiteSpace(scheduledEventTypeErrorMessage))
                {
                    <p id="scheduled-event-type-error" class="field-error" role="alert">@scheduledEventTypeErrorMessage</p>
                }
            </div>
            <div class="event-form-field">
                <label for="recurrence-interval">Repeat</label>
                <select id="recurrence-interval" class="participant-input" @bind="recurrenceInterval">
                    <option value="">Does not repeat</option>
                    <option value="1">Weekly</option>
                    <option value="2">Every 2 weeks</option>
                </select>
            </div>
            @if (!string.IsNullOrEmpty(recurrenceInterval))
            {
                <div class="event-form-field">
                    <label for="recurrence-end-date">Repeat until</label>
                    <input id="recurrence-end-date"
                           type="date"
                           class="participant-input"
                           @bind="recurrenceEndDate"
                           aria-describedby="recurrence-end-date-help recurrence-error"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(recurrenceErrorMessage))" />
                    <p id="recurrence-end-date-help" class="field-help">The end date is included.</p>
                </div>
            }
            <div class="event-form-field event-description-field">
                <label for="scheduled-event-description">Description <span>(optional)</span></label>
                <textarea id="scheduled-event-description"
                          class="participant-input"
                          maxlength="500"
                          rows="3"
                          @bind="scheduledEventDescription"
                          aria-describedby="scheduled-event-description-help"></textarea>
                <p id="scheduled-event-description-help" class="field-help">Up to 500 characters.</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(recurrenceErrorMessage))
            {
                <p id="recurrence-error" class="field-error" role="alert">@recurrenceErrorMessage</p>
            }
            <button type="submit" class="primary-action">Add event</button>
        </form>
    }

    @if (scheduledEvents.Count == 0)
    {
        <p class="empty-state">No dated events yet. An event type and date are required.</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(removeScheduledEventErrorMessage))
        {
            <p class="field-error" role="alert">@removeScheduledEventErrorMessage</p>
        }
        <ol class="scheduled-event-list" aria-label="Dated events">
            @foreach (var scheduledEvent in scheduledEvents)
            {
                var eventType = eventTypes.FirstOrDefault(candidate => candidate.Id == scheduledEvent.EventTypeId);
                <li class="scheduled-event-card" @key="scheduledEvent.Id">
                    <div>
                        <p class="scheduled-event-date">@scheduledEvent.Date.ToString("MMMM d, yyyy", CultureInfo.CurrentCulture)</p>
                        @if (eventType is null)
                        {
                            <p class="field-error" role="alert">Missing event type (this event type was deleted).</p>
                        }
                        else
                        {
                            <h3>@eventType.Name</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(scheduledEvent.Description))
                        {
                            <p class="scheduled-event-description">@scheduledEvent.Description</p>
                        }
                    </div>
                    <button type="button"
                            class="secondary-action"
                            aria-label="@($"Remove {eventType?.Name ?? "event with missing type"} on {scheduledEvent.Date:d}")"
                            @onclick="() => RemoveScheduledEventAsync(scheduledEvent.Id)">
                        Remove event
                    </button>
                </li>
            }
        </ol>
    }
</section>


<GeneratedScheduleSection Validation="validation" />


<section class="navigation-footer" aria-label="Team setup">
    <p>Need to change participants or tasks? <a href="/team">Go to team setup</a>.</p>
</section>

@code {
    private IReadOnlyList<EventType> eventTypes = [];
    private DateTime? scheduledEventDate;
    private string selectedEventTypeId = string.Empty;
    private string scheduledEventDescription = string.Empty;
    private string recurrenceInterval = string.Empty;
    private DateTime? recurrenceEndDate;
    private string? scheduledEventDateErrorMessage;
    private string? scheduledEventTypeErrorMessage;
    private string? scheduledEventErrorMessage;
    private string? recurrenceErrorMessage;
    private string? removeScheduledEventErrorMessage;
    private IReadOnlyList<ScheduledEvent> scheduledEvents = [];

    protected override void OnInitialized()
    {
        RefreshEventTypes();
        RefreshScheduledEvents();
    }

    private async Task AddScheduledEventAsync()
    {
        scheduledEventDateErrorMessage = null;
        scheduledEventTypeErrorMessage = null;
        scheduledEventErrorMessage = null;
        recurrenceErrorMessage = null;

        if (scheduledEventDate is null)
        {
            scheduledEventDateErrorMessage = "Choose a date.";
            return;
        }

        var date = DateOnly.FromDateTime(scheduledEventDate.Value);

        if (!Guid.TryParse(selectedEventTypeId, out var eventTypeId))
        {
            scheduledEventTypeErrorMessage = "Select an event type.";
            return;
        }

        ApplicationOperationResult result;
        if (string.IsNullOrEmpty(recurrenceInterval))
        {
            result = await ConfigurationStateService.AddScheduledEventAsync(date, eventTypeId, scheduledEventDescription);
        }
        else if (!int.TryParse(recurrenceInterval, out var intervalWeeks))
        {
            recurrenceErrorMessage = "Choose a weekly or biweekly recurrence interval.";
            return;
        }
        else if (recurrenceEndDate is null)
        {
            recurrenceErrorMessage = "Choose a repeat-until date.";
            return;
        }
        else
        {
            result = await ConfigurationStateService.AddRecurringScheduledEventsAsync(
                date,
                DateOnly.FromDateTime(recurrenceEndDate.Value),
                eventTypeId,
                intervalWeeks,
                scheduledEventDescription);
        }

        if (result.IsSuccess)
        {
            scheduledEventDate = null;
            selectedEventTypeId = string.Empty;
            scheduledEventDescription = string.Empty;
            recurrenceInterval = string.Empty;
            recurrenceEndDate = null;
            RefreshScheduledEvents();
            return;
        }

        if (!string.IsNullOrEmpty(recurrenceInterval))
        {
            recurrenceErrorMessage = result.ErrorMessage;
        }
        else
        {
            scheduledEventErrorMessage = result.ErrorMessage;
        }
    }

    private async Task RemoveScheduledEventAsync(Guid scheduledEventId)
    {
        var result = await ConfigurationStateService.RemoveScheduledEventAsync(scheduledEventId);
        if (result.IsSuccess)
        {
            removeScheduledEventErrorMessage = null;
            RefreshScheduledEvents();
        }
        else
        {
            removeScheduledEventErrorMessage = result.ErrorMessage;
        }
    }

    private void RefreshEventTypes()
    {
        eventTypes = StateStore.Current.EventTypes
            .OrderBy(eventType => eventType.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void RefreshScheduledEvents()
    {
        scheduledEvents = StateStore.Current.ScheduledEvents
            .OrderBy(scheduledEvent => scheduledEvent.Date)
            .ToList();
    }
}
