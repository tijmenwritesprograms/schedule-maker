@page "/"
@using ScheduleMaker.App.Application
@using ScheduleMaker.App.Domain
@using System.Globalization
@inject ApplicationStateStore StateStore
@inject ConfigurationStateService ConfigurationStateService

<PageTitle>Schedule Maker</PageTitle>

@{
    var validation = ConfigurationStateService.ValidateCurrentConfiguration();
}

<section class="welcome-panel" aria-labelledby="page-title">
    <p class="eyebrow">Schedule Maker</p>
    <h1 id="page-title">Build a fair schedule</h1>
    <p class="intro">Add your participants, event types, and dated events to get started.</p>
</section>

@if (!string.IsNullOrWhiteSpace(StateStore.PersistenceError))
{
    <p class="error-message" role="alert">@StateStore.PersistenceError</p>
}

<section class="setup-panel" aria-labelledby="participants-title">
    <div class="section-header">
        <h2 id="participants-title">Participants</h2>
        <p class="section-description">Add each person who should share recurring tasks.</p>
    </div>

    <form class="participant-form" @onsubmit="AddParticipantAsync" @onsubmit:preventDefault="true">
        <div class="participant-field">
            <label for="participant-name">Participant name</label>
            <input id="participant-name"
                   type="text"
                   class="participant-input"
                   @bind="participantName"
                   @bind:event="oninput"
                   aria-describedby="@GetParticipantFieldDescription()" />
            <p id="participant-help" class="field-help">Enter one name at a time, then select Add participant.</p>
            @if (!string.IsNullOrWhiteSpace(participantInputErrorMessage))
            {
                <p id="participant-feedback" class="field-error" role="alert">@participantInputErrorMessage</p>
            }
        </div>

        <button type="submit" class="primary-action">Add participant</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(participantListErrorMessage))
    {
        <p class="field-error" role="alert">@participantListErrorMessage</p>
    }

    @if (participants.Count == 0)
    {
        <p class="empty-state">Add your first participant above to start building the schedule.</p>
    }
    else
    {
        <ul class="participant-list" role="list" aria-label="Participants">
            @foreach (var participant in participants)
            {
                <li class="participant-list-item" @key="participant.Id">
                    <span>@participant.Name</span>
                    <button type="button"
                            class="secondary-action"
                            aria-label="@($"Remove {participant.Name}")"
                            @onclick="() => RemoveParticipantAsync(participant.Id)">
                        Remove
                    </button>
                </li>
            }
        </ul>
    }
</section>

<section class="setup-panel" aria-labelledby="setup-title">
    <h2 id="setup-title">Your schedule</h2>
    <p class="empty-state">@validation.NextStepMessage</p>

    @if (validation.Issues.Count > 0)
    {
        <ul class="validation-summary" role="list">
            @foreach (var issue in validation.Issues)
            {
                <li>@issue.Message</li>
            }
        </ul>
    }
</section>

<section class="setup-panel" aria-labelledby="event-types-title">
    <div class="section-header">
        <h2 id="event-types-title">Event types</h2>
        <p class="section-description">Create reusable event types, then add their tasks in the order they should be done.</p>
    </div>

    <form class="participant-form" @onsubmit="AddEventTypeAsync" @onsubmit:preventDefault="true">
        <div class="participant-field">
            <label for="event-type-name">Event type name</label>
            <input id="event-type-name"
                   type="text"
                   class="participant-input"
                   @bind="eventTypeName"
                   @bind:event="oninput"
                   aria-describedby="event-type-help" />
            <p id="event-type-help" class="field-help">Add the event type first, then add one or more tasks.</p>
            @if (!string.IsNullOrWhiteSpace(eventTypeInputErrorMessage))
            {
                <p class="field-error" role="alert">@eventTypeInputErrorMessage</p>
            }
        </div>
        <button type="submit" class="primary-action">Add event type</button>
    </form>

    @if (eventTypes.Count == 0)
    {
        <p class="empty-state">No event types yet. Add your first event type above, then add its first task.</p>
    }
    else
    {
        <div class="event-type-list">
            @foreach (var eventType in eventTypes)
            {
                <article class="event-type-card" @key="eventType.Id">
                    <div class="event-type-header">
                        <div>
                            <h3>@eventType.Name</h3>
                            @if (eventType.Tasks.Count == 0)
                            {
                                <p class="field-error" role="status">Add a task before using this event type for scheduling.</p>
                            }
                        </div>
                        <button type="button"
                                class="secondary-action"
                                aria-label="@($"Remove event type {eventType.Name}")"
                                @onclick="() => RemoveEventTypeAsync(eventType.Id)">
                            Remove event type
                        </button>
                    </div>

                    @if (eventType.Tasks.Count > 0)
                    {
                        <ol class="task-list">
                            @foreach (var task in eventType.Tasks.OrderBy(task => task.SortOrder))
                            {
                                <li @key="task.Id">
                                    <span>@task.Name</span>
                                    <button type="button"
                                            class="secondary-action"
                                            aria-label="@($"Remove task {task.Name} from {eventType.Name}")"
                                            @onclick="() => RemoveTaskAsync(eventType.Id, task.Id)">
                                        Remove
                                    </button>
                                </li>
                            }
                        </ol>
                    }

                    <form class="task-form" @onsubmit="() => AddTaskAsync(eventType.Id)" @onsubmit:preventDefault="true">
                        <label for="@($"task-name-{eventType.Id}")">Add task to @eventType.Name</label>
                        <div class="task-form-controls">
                            <input id="@($"task-name-{eventType.Id}")"
                                   type="text"
                                   class="participant-input"
                                   @bind="taskNames[eventType.Id]"
                                   @bind:event="oninput" />
                            <button type="submit" class="primary-action">Add task</button>
                        </div>
                        @if (taskInputErrorMessages.TryGetValue(eventType.Id, out var taskError))
                        {
                            <p class="field-error" role="alert">@taskError</p>
                        }
                    </form>
                </article>
            }
        </div>
    }
</section>

<section class="setup-panel" aria-labelledby="events-title">
    <div class="section-header">
        <h2 id="events-title">Dated events</h2>
        <p class="section-description">Add each event date and choose the event type whose tasks should be scheduled.</p>
    </div>

    @if (eventTypes.Count == 0)
    {
        <p class="empty-state">Add an event type before creating a dated event.</p>
    }
    else
    {
        <form class="event-form" @onsubmit="AddScheduledEventAsync" @onsubmit:preventDefault="true">
            <div class="event-form-field">
                <label for="scheduled-event-date">Date</label>
                <input id="scheduled-event-date"
                       type="date"
                       class="participant-input"
                       @bind="scheduledEventDate"
                       aria-describedby="scheduled-event-date-help" />
                <p id="scheduled-event-date-help" class="field-help">Choose when this event takes place.</p>
                @if (!string.IsNullOrWhiteSpace(scheduledEventDateErrorMessage))
                {
                    <p class="field-error" role="alert">@scheduledEventDateErrorMessage</p>
                }
            </div>
            <div class="event-form-field">
                <label for="scheduled-event-type">Event type</label>
                <select id="scheduled-event-type"
                        class="participant-input"
                        @bind="selectedEventTypeId">
                    <option value="">Select an event type</option>
                    @foreach (var eventType in eventTypes)
                    {
                        <option value="@eventType.Id">@eventType.Name</option>
                    }
                </select>
                @if (!string.IsNullOrWhiteSpace(scheduledEventTypeErrorMessage))
                {
                    <p class="field-error" role="alert">@scheduledEventTypeErrorMessage</p>
                }
            </div>
            <div class="event-form-field event-description-field">
                <label for="scheduled-event-description">Description <span>(optional)</span></label>
                <textarea id="scheduled-event-description"
                          class="participant-input"
                          maxlength="500"
                          rows="3"
                          @bind="scheduledEventDescription"
                          aria-describedby="scheduled-event-description-help"></textarea>
                <p id="scheduled-event-description-help" class="field-help">Up to 500 characters.</p>
                @if (!string.IsNullOrWhiteSpace(scheduledEventDescriptionErrorMessage))
                {
                    <p class="field-error" role="alert">@scheduledEventDescriptionErrorMessage</p>
                }
            </div>
            <button type="submit" class="primary-action">Add event</button>
        </form>
    }

    @if (scheduledEvents.Count == 0)
    {
        <p class="empty-state">No dated events yet. An event type and date are required.</p>
    }
    else
    {
        <ol class="scheduled-event-list" aria-label="Dated events">
            @foreach (var scheduledEvent in scheduledEvents)
            {
                var eventType = eventTypes.FirstOrDefault(candidate => candidate.Id == scheduledEvent.EventTypeId);
                <li class="scheduled-event-card" @key="scheduledEvent.Id">
                    <div>
                        <p class="scheduled-event-date">@scheduledEvent.Date.ToString("MMMM d, yyyy", CultureInfo.CurrentCulture)</p>
                        @if (eventType is null)
                        {
                            <p class="field-error" role="alert">Missing event type (this event type was deleted).</p>
                        }
                        else
                        {
                            <h3>@eventType.Name</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(scheduledEvent.Description))
                        {
                            <p class="scheduled-event-description">@scheduledEvent.Description</p>
                        }
                    </div>
                    <button type="button"
                            class="secondary-action"
                            aria-label="@($"Remove event on {scheduledEvent.Date:d}")"
                            @onclick="() => RemoveScheduledEventAsync(scheduledEvent.Id)">
                        Remove event
                    </button>
                </li>
            }
        </ol>
    }
</section>

@code {
    private string participantName = string.Empty;
    private string? participantInputErrorMessage;
    private string? participantListErrorMessage;
    private IReadOnlyList<Participant> participants = [];
    private IReadOnlyList<EventType> eventTypes = [];
    private string eventTypeName = string.Empty;
    private string? eventTypeInputErrorMessage;
    private readonly Dictionary<Guid, string> taskNames = [];
    private readonly Dictionary<Guid, string> taskInputErrorMessages = [];
    private DateTime? scheduledEventDate;
    private string selectedEventTypeId = string.Empty;
    private string scheduledEventDescription = string.Empty;
    private string? scheduledEventDateErrorMessage;
    private string? scheduledEventTypeErrorMessage;
    private string? scheduledEventDescriptionErrorMessage;
    private IReadOnlyList<ScheduledEvent> scheduledEvents = [];

    protected override void OnInitialized()
    {
        RefreshParticipants();
        RefreshEventTypes();
        RefreshScheduledEvents();
    }

    private async Task AddEventTypeAsync()
    {
        var result = await ConfigurationStateService.AddEventTypeAsync(eventTypeName);
        if (result.IsSuccess)
        {
            eventTypeName = string.Empty;
            eventTypeInputErrorMessage = null;
            RefreshEventTypes();
        }
        else
        {
            eventTypeInputErrorMessage = result.ErrorMessage;
        }
    }

    private async Task AddTaskAsync(Guid eventTypeId)
    {
        var taskName = taskNames.GetValueOrDefault(eventTypeId, string.Empty);
        var result = await ConfigurationStateService.AddTaskAsync(eventTypeId, taskName);
        if (result.IsSuccess)
        {
            taskNames[eventTypeId] = string.Empty;
            taskInputErrorMessages.Remove(eventTypeId);
            RefreshEventTypes();
        }
        else
        {
            taskInputErrorMessages[eventTypeId] = result.ErrorMessage ?? "Task could not be added.";
        }
    }

    private async Task RemoveTaskAsync(Guid eventTypeId, Guid taskId)
    {
        var result = await ConfigurationStateService.RemoveTaskAsync(eventTypeId, taskId);
        if (result.IsSuccess)
        {
            taskInputErrorMessages.Remove(eventTypeId);
            RefreshEventTypes();
        }
        else
        {
            taskInputErrorMessages[eventTypeId] = result.ErrorMessage ?? "Task could not be removed.";
        }
    }

    private async Task RemoveEventTypeAsync(Guid eventTypeId)
    {
        var result = await ConfigurationStateService.RemoveEventTypeAsync(eventTypeId);
        if (result.IsSuccess)
        {
            taskNames.Remove(eventTypeId);
            taskInputErrorMessages.Remove(eventTypeId);
            RefreshEventTypes();
        }
        else
        {
            eventTypeInputErrorMessage = result.ErrorMessage;
        }
    }

    private async Task AddParticipantAsync()
    {
        var result = await ConfigurationStateService.AddParticipantAsync(participantName);
        if (result.IsSuccess)
        {
            participantName = string.Empty;
            participantInputErrorMessage = null;
            participantListErrorMessage = null;
            RefreshParticipants();
            return;
        }

        participantInputErrorMessage = result.ErrorMessage;
        participantListErrorMessage = null;
    }

    private async Task RemoveParticipantAsync(Guid participantId)
    {
        participantInputErrorMessage = null;
        var result = await ConfigurationStateService.RemoveParticipantAsync(participantId);
        if (result.IsSuccess)
        {
            participantListErrorMessage = null;
            RefreshParticipants();
        }
        else
        {
            participantListErrorMessage = result.ErrorMessage;
        }
    }

    private async Task AddScheduledEventAsync()
    {
        scheduledEventDateErrorMessage = null;
        scheduledEventTypeErrorMessage = null;
        scheduledEventDescriptionErrorMessage = null;

        if (scheduledEventDate is null)
        {
            scheduledEventDateErrorMessage = "Choose a date.";
            return;
        }

        var date = DateOnly.FromDateTime(scheduledEventDate.Value);

        if (!Guid.TryParse(selectedEventTypeId, out var eventTypeId))
        {
            scheduledEventTypeErrorMessage = "Select an event type.";
            return;
        }

        var result = await ConfigurationStateService.AddScheduledEventAsync(date, eventTypeId, scheduledEventDescription);
        if (result.IsSuccess)
        {
            scheduledEventDate = null;
            scheduledEventDescription = string.Empty;
            RefreshScheduledEvents();
            return;
        }

        scheduledEventDescriptionErrorMessage = result.ErrorMessage;
    }

    private async Task RemoveScheduledEventAsync(Guid scheduledEventId)
    {
        var result = await ConfigurationStateService.RemoveScheduledEventAsync(scheduledEventId);
        if (result.IsSuccess)
        {
            RefreshScheduledEvents();
        }
        else
        {
            scheduledEventDescriptionErrorMessage = result.ErrorMessage;
        }
    }

    private string GetParticipantFieldDescription() =>
        string.IsNullOrWhiteSpace(participantInputErrorMessage)
            ? "participant-help"
            : "participant-help participant-feedback";

    private void RefreshParticipants()
    {
        participants = StateStore.Current.Participants
            .OrderBy(participant => participant.SortOrder)
            .ToList();
    }

    private void RefreshEventTypes()
    {
        eventTypes = StateStore.Current.EventTypes
            .OrderBy(eventType => eventType.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        foreach (var eventType in eventTypes)
        {
            taskNames.TryAdd(eventType.Id, string.Empty);
        }
    }

    private void RefreshScheduledEvents()
    {
        scheduledEvents = StateStore.Current.ScheduledEvents
            .OrderBy(scheduledEvent => scheduledEvent.Date)
            .ToList();
    }
}
